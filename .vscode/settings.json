{
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.pluginPaths": ["frontend/node_modules"],
  "vetur.enable": false,
  "vue.inlayHints.destructureProps": true,
  "vue.inlayHints.missingProps": true,
  "tailwindCSS.experimental.configFile": "frontend/src/index.css",
  "tailwindCSS.includeLanguages": {
    "vue": "html"
  },
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.suggestCanonicalClasses": "warning",
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  "tailwindCSS.lint.recommendedVariantOrder": "warning"
}
