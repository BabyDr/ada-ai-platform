# 仓库根目录环境变量示例（Sidecar 启动时会加载；backend/.env 同名项优先覆盖）

# mock：本地预设流式输出，无需密钥；real：调用真实 GLM 流式接口
LLM_MODE=mock

# 单任务超时秒数（默认 60）
# TASK_TIMEOUT_SECONDS=60

# 智谱 GLM（LLM_MODE=real 或 Agent Chat 时使用）
# GLM_API_KEY=sk-your-key
# GLM_MODEL=glm-4-flash
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 详细说明见 backend/.env.example
